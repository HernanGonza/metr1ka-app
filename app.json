{
  "expo": {
    "name": "Metr1ka",
    "slug": "metr1ka",
    "scheme": "metr1ka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/isotipo-transparente.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/isotipo-transparente.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.metr1ka.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/isotipo-transparente.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.metr1ka.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "minSdkVersion": 33,
      "targetSdkVersion": 34
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/isotipo-transparente.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-secure-store",
      "expo-updates"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63f7f8cd-5597-4002-93d9-d30d3f3df5c2"
      }
    },
    "owner": "paralelo",
    "updates": {
      "url": "https://u.expo.dev/63f7f8cd-5597-4002-93d9-d30d3f3df5c2",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}